MULTIBROKER_PORT=5057
PORT=5057

# Change this password immediately on your VPS (or via Admin -> Security tab)
ADMIN_PASSWORD=ChangeMeStrong2026!

# Default Public Account: Delta Exchange India (Withdrawals OFF)
# You can also add/edit your Delta account + Tradovate/Webhook/MT5 accounts directly in the HTML Admin UI!
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_ACCOUNT_ID=PRIMARY-DELTA
DELTA_API_KEY=
DELTA_API_SECRET=
LEVERAGE=100
FIXED_RISK_USD=2.0

# Optional Telegram Live Trade & IST Daily Summary Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
